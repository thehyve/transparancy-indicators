-- unplanned_reoperation.tpl.sparql — generic "unplanned reoperation after
-- primary resection" indicator template for RDF/OWL
--
-- Disease-agnostic SPARQL query, modeled directly against the ti-o
-- ontology (matching Voorbeeld volume/volume.ipynb and the Mortaliteit/
-- PROM/Wachttijd reference examples): the resection and the reoperation
-- are each typed with a ti-o class and linked to their participating
-- patient / disorder via obo:RO_0000057 ("has participant"); the
-- reoperation is linked back to the resection via obo:RO_0002404
-- ("causally downstream of"). Which ti-o concepts count as
-- inclusion/exclusion/resection are supplied per disease via
-- diseases/<Disease>/*.sparql blocks.
--
-- Note: the "within 30 days" window uses xsd:duration arithmetic on a
-- date, which production triplestores (Fuseki, GraphDB, Virtuoso) support
-- but rdflib does not — see Voorbeeld PROM/indicator_4c_leesbaar.sparql.
--
-- The {{ti-o:...}} tokens are left as-is for hospital-side resolution via
-- localize_sparql.py or equivalent SPARQL resolver. {{START_DATE}} /
-- {{END_DATE}} are resolved the same way.
--
-- Usage: substitute ${...} blocks at maintainer time (compose.py), then
-- substitute {{ti-o:...}} / {{START_DATE}} / {{END_DATE}} tokens at
-- hospital time (localize_sparql.py or by hand).

PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX ti-o: <https://w3id.org/zinl/ti-o#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT
    ?locatie
    (COUNT(DISTINCT ?heroperatie) AS ?teller_heroperaties)
    (COUNT(DISTINCT ?resectie) AS ?noemer_resecties)
    (ROUND(100.0 * COUNT(DISTINCT ?heroperatie) / COALESCE(COUNT(DISTINCT ?resectie), 1), 1) AS ?percentage_heroperaties)
WHERE {
    # --- Primary condition: the disorder being treated (inclusion criterion) ---
    ?disorder a ?inclusionType .
    VALUES ?inclusionType { {{ti-o:HeadNeckOralCavity}}
        {{ti-o:HeadNeckOropharynx}}
        {{ti-o:HeadNeckNasopharynx}}
        {{ti-o:HeadNeckHypopharynx}}
        {{ti-o:HeadNeckLarynx}}
        {{ti-o:HeadNeckNasalCavityAndSinuses}}
        {{ti-o:HeadNeckSalivaryGlands}}
        {{ti-o:HeadNeckLymphNodeMetastases}}
 }

    # --- Resection: treatment of the primary condition, in the reporting period ---
    ?resectie
        a ?resectionType ;
        obo:RO_0000057 ?patient ;
        obo:RO_0000057 ?disorder ;
        obo:BFO_0000066 ?locatie ;
        time:hasTime/time:hasBeginning/time:inXSDDate ?resectieDatum .

    VALUES ?resectionType { {{ti-o:HeadNeckResection}}
 }

    FILTER(?resectieDatum >= xsd:date('{{START_DATE}}') && ?resectieDatum < xsd:date('{{END_DATE}}'))

    ?patient
        a obo:NCBITAXON_9606 ;
        obo:BFO_0000051 ?disorder .

    # --- Exclusion: patient must not have a disqualifying disorder ---
    FILTER NOT EXISTS {
        ?patient obo:BFO_0000051 ?exclusieDisorder .
        ?exclusieDisorder a ?exclusieType .
        VALUES ?exclusieType { {{ti-o:CarcinomaInSitu}} {{ti-o:HeadNeckOtherExcludedHistology}}
 }
    }

    # --- Optional: unplanned reoperation for complication within 30 days ---
    OPTIONAL {
        ?heroperatie
            a ti-o:UnplannedReoperationForComplication ;
            obo:RO_0000057 ?patient ;
            obo:RO_0002404 ?resectie ;
            time:hasTime/time:hasBeginning/time:inXSDDate ?heroperatieDatum .
        FILTER(?heroperatieDatum > ?resectieDatum &&
               ?heroperatieDatum <= ?resectieDatum + "P30D"^^xsd:duration)
    }
}
GROUP BY ?locatie
ORDER BY ?locatie
