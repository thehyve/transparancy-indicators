-- volume.tpl.sparql — generic "treatment volume" indicator template for RDF/OWL
--
-- Disease-agnostic SPARQL query, modeled directly against the ti-o
-- ontology (matching Voorbeeld volume/volume.ipynb): a treatment is typed
-- with a ti-o class (?behandelingType) and linked to its participating
-- patient and disorder via obo:RO_0000057 ("has participant"). Which ti-o
-- concepts count as inclusion/exclusion are supplied per disease via
-- diseases/<Disease>/*.sparql blocks.
--
-- The {{ti-o:...}} tokens are left as-is for hospital-side resolution via
-- localize_sparql.py or equivalent SPARQL resolver. {{START_DATE}} /
-- {{END_DATE}} are resolved the same way.
--
-- Usage: substitute ${...} blocks at maintainer time (compose.py), then
-- substitute {{ti-o:...}} / {{START_DATE}} / {{END_DATE}} tokens at
-- hospital time (localize_sparql.py or by hand).

PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX ti-o: <https://w3id.org/zinl/ti-o#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>

SELECT
    ?locatie
    (COUNT(DISTINCT ?behandeling) AS ?aantal)
WHERE {
    # --- Reporting period: treatment's begin date falls within the period ---
    ?behandeling time:hasTime/time:hasBeginning/time:inXSDDate ?datumBehandeling .
    FILTER(?datumBehandeling >= xsd:date('{{START_DATE}}') && ?datumBehandeling < xsd:date('{{END_DATE}}'))

    # --- Treatment of an included type, with participating patient and disorder ---
    ?behandeling
        a ?behandelingType ;
        obo:RO_0000057 ?patient ;
        obo:RO_0000057 ?disorder .

    VALUES ?behandelingType { {{ti-o:THP}}
 }

    ?patient
        a obo:NCBITAXON_9606 ;
        obo:BFO_0000051 ?disorder .

    # --- Location: where the treatment takes place ---
    ?behandeling obo:BFO_0000066 ?locatie .

    # --- Exclusion: treatment's participating disorder must not be a
    #     disqualifying class ---
    FILTER NOT EXISTS {
        ?disorder a ?exclusieType .
        VALUES ?exclusieType { {{ti-o:HipFracture}}
 }
    }
}
GROUP BY ?locatie
ORDER BY ?locatie
